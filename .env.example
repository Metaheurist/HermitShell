# HermitShell shared settings.
#
# The easiest way to fill these in is the setup wizard: python3 scripts/setup.py
# Or copy the lines you need into .env in HermitShell's home (HERMITSHELL_HOME: /data in the container,
# /opt/hermitshell for the service), or pass them as environment variables. Real environment variables
# always win over the .env file.
# Never commit a filled-in copy of this file.
#
# Lines starting with "# @basic" mark the settings the wizard asks for by default; it asks for
# everything with --advanced.

# ---------------------------------------------------------------- email (SMTP)
# Any SMTP server with STARTTLS works. For Gmail, create an App Password (Google Account >
# Security > 2-Step Verification > App passwords) and use it as SMTP_PASSWORD.
# @basic
SMTP_HOST=smtp.example.com
# @basic
SMTP_PORT=587
# @basic
SMTP_USER=you@example.com
# @basic
SMTP_PASSWORD=change-me
# Optional: sender address if different from SMTP_USER.
SMTP_FROM=
# Where reports are delivered. Defaults to SMTP_USER.
# @basic
ALERT_EMAIL=you@example.com
# Admin alerts by email (low credits, providers resting, Ollama down, backups, disk, Worker version): 1 on, 0 off.
HERMES_ALERTS=1
# Alert below this percentage of a key's allowance left, and of the disk free.
ALERT_CREDITS_BELOW_PCT=10
ALERT_DISK_BELOW_PCT=10
# Make an interview prep pack by itself when a job reaches Interview: 1 on, 0 off (the dashboard button works either way).
INTERVIEW_PREP_AUTO=0
# Also make a Word copy of each cover letter, tailored CV and prep pack, emailed with the PDF: 1 on, 0 off.
DOC_WORD_COPIES=0
# Let recruits sign in at /me on the feedback Worker with a one-time emailed link: 1 on, 0 off.
HERMES_SELF_SERVICE=0

# ---------------------------------------------------------------- web data providers
# At least one search provider is needed. Firecrawl is preferred; Tavily and Scrapfly are backups.
# @basic
FIRECRAWL_API_KEY=
# Optional comma-separated extra Firecrawl keys, tried in order when the main key runs out of credits.
# @basic
FIRECRAWL_BACKUP_KEYS=
# @basic
TAVILY_API_KEY=
# @basic
SCRAPFLY_API_KEY=
# Provider order (comma-separated). Providers without a key are skipped automatically.
WEB_SEARCH_ORDER=firecrawl,tavily
WEB_SCRAPE_ORDER=firecrawl,scrapfly,tavily
# Optional Scrapfly proxy country (two-letter code), for sites that geo-block.
SCRAPFLY_COUNTRY=
# How often (minutes) the dashboard's Global settings checks how much of each key's allowance is left, with
# the provider's free account endpoint (no search credits are spent). 0 turns it off.
WEB_KEY_USAGE_MINUTES=60

# ---------------------------------------------------------------- model (Ollama)
# The Ollama server and model every script uses. In the container, http://host.docker.internal:11434
# reaches an Ollama on the Docker host; http://ollama:11434 one in a container named ollama on the same
# network. When OLLAMA_HOST doesn't answer, OLLAMA_FALLBACK_HOST and then both of those are tried.
OLLAMA_HOST=http://ollama:11434
OLLAMA_FALLBACK_HOST=http://localhost:11434
OLLAMA_MODEL=
# Optional context size (tokens) for OLLAMA_MODEL; empty lets autofit choose.
OLLAMA_NUM_CTX=
# Optional extra Ollama servers, comma-separated (http://ollama-gpu1:11435). Only http(s)://host:port.
# The wizard fills this in when it starts one Ollama per GPU.
OLLAMA_HOSTS=
# How many model requests may run at once across every script and profile. They wait in one shared
# queue (cover letters, tailored CVs and new profiles first). auto = one per working Ollama server;
# a number fixes it (raise it only if Ollama runs requests in parallel, OLLAMA_NUM_PARALLEL).
HERMES_MODEL_CONCURRENCY=auto
# Autofit picks the context size, GPU layers, CPU threads and Ollama server for each request, and
# steps down when memory runs out. off = send the model settings above unchanged.
HERMES_AUTOFIT=auto
# Optional fixed CPU threads per model request, instead of letting autofit time the choices.
HERMES_AUTOFIT_THREADS=

# ---------------------------------------------------------------- cloud models (optional)
# For servers that can't run Ollama: OpenAI-compatible cloud models, asked in LLM_PROVIDERS order before
# Ollama (LLM_ORDER=local asks Ollama first). A provider out of credits or over its daily limit rests
# until midnight UTC and the next one, then Ollama, answers. They are sent each recruit's CV and the job
# adverts; free models may keep what they are sent. Each _MODEL is optional (blank = the provider's default).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
BAZAARLINK_API_KEY=
BAZAARLINK_MODEL=
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=
LLM_PROVIDERS=openrouter,bazaarlink,featherless,huggingface
LLM_ORDER=cloud
# How many jobs a run rates at once with the cloud models (1-8). Free plans allow a few requests a minute;
# a provider that answers "too many requests" rests while the next one answers.
LLM_CLOUD_CONCURRENCY=2

# ---------------------------------------------------------------- paths and locale
# IANA timezone used for dates in the emails (Europe/London, America/New_York...).
# @basic
HERMES_TIMEZONE=UTC
# Optional: where packages keep seen-state, caches and last reports. Defaults to <scripts>/state.
HERMES_STATE_DIR=

# ---------------------------------------------------------------- scheduler
# A run still going after this many seconds is stopped (default 6 hours).
HERMITSHELL_JOB_TIMEOUT=21600
# A run missed while HermitShell was stopped is started late if it was due within this many minutes.
HERMITSHELL_CATCHUP_MINUTES=30

# ---------------------------------------------------------------- data protection
# Encrypts CVs, profiles, crawler keys, cover letters, tailored CVs and the nightly backups (AES-256-GCM).
# The wizard makes one (or: python3 maintenance.py --new-key). Keep a copy in a password manager: without it
# those files and backups can't be read. Never replace it once files have been encrypted with it.
# @wizard
HERMES_DATA_KEY=
# Days to keep tracker jobs, cover letters and tailored CVs, and logs and scheduled-job output (0 = forever).
HERMES_RETENTION_DAYS=365
HERMES_LOG_RETENTION_DAYS=90
# Nightly encrypted backups: folder (default <home>/backups/nightly) and how many to keep. In Docker, a NAS share
# or another disk is mounted at /backups (docs/configuration.md#backups-somewhere-else).
HERMES_BACKUP_DIR=
HERMES_BACKUP_KEEP_DAILY=14
HERMES_BACKUP_KEEP_WEEKLY=8
