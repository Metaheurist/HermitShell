# The explore stack's settings. Copy to %LOCALAPPDATA%\HermitShell\explore\.env.explore (outside the repo and
# OneDrive), or let `node explore/run.mjs up` create it with fresh random secrets. Only these names are accepted.

# Web search for the job scans. Leave empty to skip scans; each run is capped by the two limits below.
FIRECRAWL_API_KEY=

# Throwaway secrets for this stack only; `up` fills them with random values when empty.
EXPLORE_LINK_SECRET=
EXPLORE_API_TOKEN=
EXPLORE_ADMIN_PASSWORD=

# The Ollama model the backend uses, and the GPU (EXPLORE_GPU=0 runs on the CPU; EXPLORE_GPUS picks cards, e.g. 0
# or 0,1; empty means all).
EXPLORE_MODEL=qwen3:4b-instruct-2507-q4_K_M
EXPLORE_GPU=1
EXPLORE_GPUS=

# Spend cap per scan: jobs scraped and rated, and job titles triaged.
JOB_SCANNER_MAX_SCRAPE=5
JOB_TRIAGE_MAX=5
