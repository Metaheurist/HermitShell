# News Digest settings. Add to $HERMES_HOME/.env alongside the shared settings
# from the repository root .env.example (or run python3 scripts/setup.py). Everything here is optional.

# ---------------------------------------------------------------- branding
# @basic
NEWS_DIGEST_TITLE=News Digest
# Line under the title. Empty = built from the chosen topic names.
NEWS_DIGEST_TAGLINE=
# Who the editor model writes for; shapes story picks and the briefing.
# @basic
NEWS_DIGEST_READER=a busy professional who wants the day's most important developments on these topics

# ---------------------------------------------------------------- topics
# Comma-separated topic ids from the catalog, in the order they appear in the email:
#   ai ml python iot newtech security cloud programming webdev data opensource smarthome
#   robotics space science climate health business markets policy world gaming sport
# Empty = ai,ml,python,iot,newtech.
# @wizard
NEWS_DIGEST_TOPICS=ai,ml,python,iot,newtech
# Extra topics of your own, "Title: keyword, keyword" separated by ||, e.g.
#   Formula 1: F1, Grand Prix || Home Brewing: homebrew, craft beer
# @wizard
NEWS_DIGEST_CUSTOM_TOPICS=
# JSON file that replaces the topics above entirely (full control over sites, queries and colours).
# See sections.example.json. Relative paths are resolved against the scripts directory.
NEWS_DIGEST_SECTIONS_FILE=

# ---------------------------------------------------------------- selection
# Stories per section in the email.
# @basic
NEWS_DIGEST_PER_SECTION=5
# Minimum importance (0-10) the editor model must give a story.
# @basic
NEWS_DIGEST_MIN_IMPORTANCE=5
# Search results requested per query.
NEWS_DIGEST_RESULTS_PER_QUERY=10
# Broaden the search when a section has fewer candidates than this.
NEWS_DIGEST_MIN_CANDIDATES=4
# Cap on candidates sent to the model per section.
NEWS_DIGEST_MAX_CANDIDATES=18
# Optional two-letter ISO country code (gb, us...) to bias news searches. Empty = worldwide.
# @basic
NEWS_DIGEST_COUNTRY=
# Days before a story that was already sent may appear again.
NEWS_DIGEST_SEEN_DAYS=7

# ---------------------------------------------------------------- limits and behaviour
# Fetch the full article for top stories so summaries use more than the snippet.
NEWS_DIGEST_SCRAPE_TOP=1
# Skip Firecrawl (use backups) when its remaining credits drop below this.
NEWS_DIGEST_MIN_CREDITS=30
# Send an email even when no stories were found.
NEWS_DIGEST_EMAIL_WHEN_EMPTY=0
# Force a specific Ollama model for this package only.
NEWS_DIGEST_MODEL=
