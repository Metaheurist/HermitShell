# Example: AI / automation roles in Northern Ireland, including nijobs.com listings.
# Append to $HERMES_HOME/.env and adjust.

JOB_REGION_NAME=Northern Ireland
JOB_SEARCH_LOCATION=Belfast
JOB_SEARCH_COUNTRY=gb
# Towns, counties and BT postcodes all count as "in region".
JOB_REGION_REGEX=\b(belfast|newtownabbey|lisburn|londonderry|derry|newry|craigavon|lurgan|portadown|banbridge|antrim|ballymena|ballymoney|coleraine|limavady|omagh|enniskillen|dungannon|cookstown|magherafelt|armagh|bangor|newtownards|holywood|carrickfergus|larne|downpatrick|comber|ballyclare|strabane|portrush|dromore|ballynahinch|carryduff|crumlin|randalstown|moira|hillsborough|castlereagh|dundonald|kilkeel|warrenpoint|county down|county tyrone|county fermanagh|county armagh|northern ireland)\b|\bBT\d{1,2}\b
JOB_SCANNER_NIJOBS_KEYWORDS=machine-learning,ai-engineer,artificial-intelligence,data-engineer,automation-engineer
# Mid-level target: Junior and Senior titles lose 1 point, Lead/Principal titles 2.
JOB_LEVEL=mid
JOB_EMPLOYMENT_TYPES=Permanent,Contract
JOB_WORK_MODES=On-site,Hybrid,Remote
# Leave out jobs advertising clearly less than £35,000 a year (unlisted salaries are kept).
JOB_MIN_SALARY=35000
JOB_SALARY_CURRENCY=GBP
HERMES_TIMEZONE=Europe/London
