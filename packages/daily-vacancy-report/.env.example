# Daily Vacancy Report settings. Add to .env in HermitShell's home alongside the shared settings
# from the repository root .env.example (or run python3 scripts/setup.py). Everything here is optional.
# "# @wizard" settings are filled in by the wizard's guided job-search and job-title steps
# rather than asked one by one.

# ---------------------------------------------------------------- branding
# @basic
JOB_REPORT_TITLE=Daily Vacancy Report
JOB_REPORT_TAGLINE=Roles matched to your CV
# Used in the model prompts ("how well does this job fit <name>?"). A first name is enough.
# @basic
JOB_CANDIDATE_NAME=the candidate

# ---------------------------------------------------------------- candidate files
# Default: job_profile.md and cv_keywords.json next to job_scanner.py. Relative paths are
# resolved against the scripts directory.
JOB_PROFILE_FILE=
JOB_KEYWORDS_FILE=

# ---------------------------------------------------------------- region
# Leave all of these empty to search without a location filter.
# Display name of the target region, also used in the model prompts.
# @wizard
JOB_REGION_NAME=
# Comma-separated towns/areas that count as inside the region (matched as whole words).
# @wizard
JOB_REGION_PLACES=
# Full regex override for the region test (takes precedence over JOB_REGION_PLACES).
JOB_REGION_REGEX=
# Keep jobs within this many km (0-500) of the recruit's Home town, as the crow flies; 0 is off. Set per recruit on the
# dashboard; needs JOB_SEARCH_COUNTRY. Place data: GeoNames (CC BY 4.0), cached in state/geo.
JOB_MAX_DISTANCE_KM=0
# Location inserted into the default web search queries. Defaults to JOB_REGION_NAME.
# @wizard
JOB_SEARCH_LOCATION=
# Two-letter ISO country code (gb, ie, us, de...) used to bias searches and confirm employer websites.
# @wizard
JOB_SEARCH_COUNTRY=
# Let fully remote jobs through the region filter (1), or only remote jobs tied to the region (0).
# @wizard
JOB_REMOTE_ANYWHERE=0

# ---------------------------------------------------------------- what kind of job
# Target seniority: junior, mid, senior, lead or any. Titles above or below it lose fit points
# (see the penalties under scoring).
# @wizard
JOB_LEVEL=any
# Comma-separated employment types to keep: Permanent, Full-time, Contract, Temporary, Part-time,
# Internship. Permanent and Full-time imply each other; jobs that don't say are always kept.
# Choosing Part-time or Internship also removes them from the default title exclusions.
# @wizard
JOB_EMPLOYMENT_TYPES=Permanent,Contract,Temporary
# Comma-separated work modes to keep: On-site, Hybrid, Remote. Jobs that don't say are always kept.
# @wizard
JOB_WORK_MODES=On-site,Hybrid,Remote
# Minimum yearly salary; jobs whose best advertised pay is clearly below it are left out. Day and
# hourly rates are converted (220 working days, 1950 hours a year). Jobs with no salary are kept. 0 = off.
# @wizard
JOB_MIN_SALARY=0
# Salary currency: GBP, EUR, USD, CAD, AUD or NZD (£, € and $ also work). Salaries in another of these are
# converted to it at the day's exchange rate, and the minimum is in it. Empty = as advertised, no conversion.
# @wizard
JOB_SALARY_CURRENCY=
# Where the day's exchange rates come from (HTTPS, Frankfurter's JSON shape; fetched once a day and cached).
# Default: Frankfurter, the European Central Bank's reference rates, no key needed. off = never convert.
JOB_FX_URL=
# Drop recruitment-agency adverts that don't name the employer (1). Repeats of the same job from
# several agencies are always merged into one card, noting who else advertises it.
# @wizard
JOB_HIDE_UNNAMED_AGENCY=0

# ---------------------------------------------------------------- discovery
# Job titles you want, separated by "||" (set from the dashboard). Changing them rebuilds the web
# queries and the strong title filter below.
# @wizard
JOB_TARGET_TITLES=
# Custom web queries separated by "||". Default: built-in AI / ML / automation / data queries
# with JOB_SEARCH_LOCATION inserted.
# @wizard
JOB_SCANNER_QUERIES=
# Search recency filter (Google tbs syntax): qdr:d day, qdr:w week, qdr:m month.
JOB_SCANNER_TBS=qdr:m
# nijobs.com keyword slugs (comma-separated). Only useful for Northern Ireland; empty disables it.
JOB_SCANNER_NIJOBS_KEYWORDS=

# ---------------------------------------------------------------- scoring
# Title pre-filter regexes (case-insensitive). Strong matches are scraped first.
# @wizard
JOB_TITLE_STRONG=
JOB_TITLE_MEDIUM=
# Titles matching this regex are always skipped. Default: internships, part-time, apprenticeships,
# sales, recruiters and some unrelated professions (nurse, teacher, driver...). Replace it if
# those are the roles you want.
# @wizard
JOB_TITLE_EXCLUDE=
# Points subtracted from the fit score for Junior/Graduate, Senior and Lead/Principal titles.
# Empty = derived from JOB_LEVEL (junior 0/2/3, mid 1/1/2, senior 2/0/1, lead 3/1/0, any 0/0/0).
JOB_JUNIOR_PENALTY=
JOB_SENIOR_PENALTY=
JOB_LEAD_PENALTY=
# Minimum fit score (0-10) for a job to appear in the report.
# @basic
JOB_SCANNER_MIN_SCORE=5
# Jobs scoring this or higher get a second, sceptical look from the model, which can only lower
# the score. 0 turns the check off.
JOB_VERIFY_MIN_FIT=8
# A shown score the model was less sure of than this (confidence 0-100) gets a second look too,
# and moves halfway to it. 0 turns the check off.
JOB_VERIFY_BELOW_CONFIDENCE=60
# A full listing naming fewer of the CV's keywords than this is skipped without a rating, unless
# the title screen called it a clear match. 0 rates every listing.
JOB_PRESCREEN_MIN_KEYWORDS=1

# ---------------------------------------------------------------- limits and behaviour
# Max job pages scraped and rated per run. Jobs whose rating fails are retried on the next runs
# (up to 4 attempts) before they are marked as seen.
# @basic
JOB_SCANNER_MAX_SCRAPE=25
# Max relevant titles screened by the model in one quick batch before rating; the rest wait.
JOB_TRIAGE_MAX=60
# Skip Firecrawl (use backups) when its remaining credits drop below this.
JOB_SCANNER_MIN_CREDITS=40
# Send an email even when nothing new matched.
# @basic
JOB_SCANNER_EMAIL_WHEN_EMPTY=0
# Force a specific Ollama model for this package only.
JOB_SCANNER_MODEL=

# ---------------------------------------------------------------- feedback buttons
# Optional buttons on each job (I applied, thumbs up / down, Interested, Cover letter, and Heard back /
# Rejected on follow-ups), served by a free Cloudflare Worker you deploy once: see
# docs/feedback-worker.md. Answers are fetched at the start of each run, calibrate the model's
# scores and drive the follow-up reminders; cover letter requests are handled by cover_letter.py.
# The wizard generates both secrets; the Worker must hold the same two values.
# With a Cloudflare account ID and API token the wizard (or scripts/cloudflare_worker.py) deploys
# and updates the Worker itself and fills in JOB_FEEDBACK_URL: docs/cloudflare-setup.md. Token
# permissions: Workers Scripts Edit, Workers KV Storage Edit (+ Access: Apps and Policies Edit
# to protect /admin with Cloudflare Access).
# @wizard
CLOUDFLARE_ACCOUNT_ID=
# @wizard
CLOUDFLARE_API_TOKEN=
# Worker name; its address is https://<name>.<your subdomain>.workers.dev.
# @wizard
CLOUDFLARE_WORKER_NAME=vacancy-feedback
# Emails let through Cloudflare Access to /admin (empty = no Access, password only).
# @wizard
CLOUDFLARE_ACCESS_EMAILS=
# @wizard
JOB_FEEDBACK_URL=
# @wizard
JOB_FEEDBACK_SECRET=
# @wizard
JOB_FEEDBACK_API_TOKEN=

# ---------------------------------------------------------------- cover letters
# The Cover letter button (feedback Worker required) emails a tailored A4 PDF letter written by
# the model from job_profile.md and the job listing; cover_letter.py checks for requests
# every 5 minutes. Name and contact line printed at the top of the letter (empty name = the
# "Candidate:" line of job_profile.md), e.g. "Belfast · you@example.com · 07700 900000".
COVER_LETTER_NAME=
COVER_LETTER_CONTACT=
# Optional fuller CV (Markdown or text, path relative to the scripts folder) for richer letters.
COVER_LETTER_CV_FILE=
COVER_LETTER_SIGN_OFF=Kind regards,
# Sender name on the cover letter emails.
COVER_LETTER_FROM_NAME=HermitShell cover letters
# Force a specific Ollama model for letters (default: JOB_SCANNER_MODEL, then OLLAMA_MODEL).
COVER_LETTER_MODEL=
# Days a finished letter or CV is reused (a request with no note sends it again instead of writing
# a new one) and kept, encrypted, on the feedback Worker for download from the email buttons and
# the dashboard's Jobs sent list. At most 30; 0 turns both off.
COVER_LETTER_KEEP_DAYS=7

# ---------------------------------------------------------------- extra profiles
# People looking for work (recruits) get their own report from this HermitShell: invite them from the
# feedback Worker's /admin page (set the Worker's ADMIN_PASSWORD secret; docs/feedback-worker.md).
# profiles.py (scheduled every 5 minutes) builds each recruit from the uploaded CV with the model, and
# every weekly roll-up and cover letter run also runs for them. They share the sources and model
# settings above; each has their own job search (titles, skills, searches, region, salary) and email.
# Once the Worker is linked (JOB_FEEDBACK_URL and JOB_FEEDBACK_API_TOKEN), the admin is staff with no
# job search: a search set up above moves once to a recruit of the same name and email, and recruits
# that shared it each keep their own copy. Their nijobs.com slugs are only generated when
# JOB_SCANNER_NIJOBS_KEYWORDS is set here.
# Where profiles are stored. Default: state/profiles next to the scripts.
JOB_PROFILES_DIR=
