# Daily Vacancy Report settings. Add to $HERMES_HOME/.env alongside the shared settings
# from the repository root .env.example (or run python3 scripts/setup.py). Everything here is optional.
# "# @wizard" settings are filled in by the wizard's guided job-search and job-title steps
# rather than asked one by one.

# ---------------------------------------------------------------- branding
# @basic
JOB_REPORT_TITLE=Daily Vacancy Report
JOB_REPORT_TAGLINE=Roles matched to your CV
# Used in the model prompts ("how well does this job fit <name>?"). A first name is enough.
# @basic
JOB_CANDIDATE_NAME=the candidate

# ---------------------------------------------------------------- candidate files
# Default: job_profile.md and cv_keywords.json next to job_scanner.py. Relative paths are
# resolved against the scripts directory.
JOB_PROFILE_FILE=
JOB_KEYWORDS_FILE=

# ---------------------------------------------------------------- region
# Leave all of these empty to search without a location filter.
# Display name of the target region, also used in the model prompts.
# @wizard
JOB_REGION_NAME=
# Comma-separated towns/areas that count as inside the region (matched as whole words).
# @wizard
JOB_REGION_PLACES=
# Full regex override for the region test (takes precedence over JOB_REGION_PLACES).
JOB_REGION_REGEX=
# Location inserted into the default web search queries. Defaults to JOB_REGION_NAME.
# @wizard
JOB_SEARCH_LOCATION=
# Two-letter ISO country code (gb, ie, us, de...) used to bias searches and confirm employer websites.
# @wizard
JOB_SEARCH_COUNTRY=
# Let fully remote jobs through the region filter (1), or only remote jobs tied to the region (0).
# @wizard
JOB_REMOTE_ANYWHERE=0

# ---------------------------------------------------------------- what kind of job
# Target seniority: junior, mid, senior, lead or any. Titles above or below it lose fit points
# (see the penalties under scoring).
# @wizard
JOB_LEVEL=any
# Comma-separated employment types to keep: Permanent, Full-time, Contract, Temporary, Part-time,
# Internship. Permanent and Full-time imply each other; jobs that don't say are always kept.
# Choosing Part-time or Internship also removes them from the default title exclusions.
# @wizard
JOB_EMPLOYMENT_TYPES=Permanent,Contract,Temporary
# Comma-separated work modes to keep: On-site, Hybrid, Remote. Jobs that don't say are always kept.
# @wizard
JOB_WORK_MODES=On-site,Hybrid,Remote

# ---------------------------------------------------------------- discovery
# Custom web queries separated by "||". Default: built-in AI / ML / automation / data queries
# with JOB_SEARCH_LOCATION inserted.
# @wizard
JOB_SCANNER_QUERIES=
# Search recency filter (Google tbs syntax): qdr:d day, qdr:w week, qdr:m month.
JOB_SCANNER_TBS=qdr:m
# nijobs.com keyword slugs (comma-separated). Only useful for Northern Ireland; empty disables it.
JOB_SCANNER_NIJOBS_KEYWORDS=

# ---------------------------------------------------------------- Indeed (MCP)
# Uses the Indeed MCP server connected to Hermes; authorise once with `hermes mcp login indeed`.
# No credentials go here: Hermes stores and refreshes the OAuth tokens. Unauthorised = skipped.
# @basic
JOB_INDEED=1
# Name of the server under mcp_servers in config.yaml.
JOB_INDEED_MCP_SERVER=indeed
# Override the server URL from config.yaml (rarely needed).
JOB_INDEED_MCP_URL=
# Plain job-title searches separated by "||". Default: AI / ML / LLM / automation / data engineer.
# @wizard
JOB_INDEED_QUERIES=
# Location passed to Indeed. Defaults to JOB_SEARCH_LOCATION.
# @wizard
JOB_INDEED_LOCATION=
# Country passed to Indeed when the tool accepts one. Defaults to JOB_SEARCH_COUNTRY.
# @wizard
JOB_INDEED_COUNTRY=
# Results per query, and maximum posting age in days (when the tool supports them).
JOB_INDEED_LIMIT=15
JOB_INDEED_DAYS=14
# Indeed site used to build job links from job keys (uk.indeed.com, ie.indeed.com...).
# @wizard
JOB_INDEED_DOMAIN=www.indeed.com
# Pin tool names if auto-detection picks the wrong one (default: detected from the tool list).
JOB_INDEED_SEARCH_TOOL=
JOB_INDEED_DETAIL_TOOL=
# Seconds allowed per MCP session (all searches, or all detail lookups).
JOB_INDEED_TIMEOUT=90

# ---------------------------------------------------------------- scoring
# Title pre-filter regexes (case-insensitive). Strong matches are scraped first.
# @wizard
JOB_TITLE_STRONG=
JOB_TITLE_MEDIUM=
# Titles matching this regex are always skipped. Default: internships, part-time, apprenticeships,
# sales, recruiters and some unrelated professions (nurse, teacher, driver...). Replace it if
# those are the roles you want.
# @wizard
JOB_TITLE_EXCLUDE=
# Points subtracted from the fit score for Junior/Graduate, Senior and Lead/Principal titles.
# Empty = derived from JOB_LEVEL (junior 0/2/3, mid 1/1/2, senior 2/0/1, lead 3/1/0, any 0/0/0).
JOB_JUNIOR_PENALTY=
JOB_SENIOR_PENALTY=
JOB_LEAD_PENALTY=
# Minimum fit score (0-10) for a job to appear in the report.
# @basic
JOB_SCANNER_MIN_SCORE=5

# ---------------------------------------------------------------- limits and behaviour
# Max job pages scraped and rated per run.
# @basic
JOB_SCANNER_MAX_SCRAPE=15
# Skip Firecrawl (use backups) when its remaining credits drop below this.
JOB_SCANNER_MIN_CREDITS=40
# Send an email even when nothing new matched.
# @basic
JOB_SCANNER_EMAIL_WHEN_EMPTY=0
# Force a specific Ollama model for this package only.
JOB_SCANNER_MODEL=
