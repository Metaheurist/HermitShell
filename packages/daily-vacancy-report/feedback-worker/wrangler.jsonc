{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vacancy-feedback",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Create the namespace (docs/feedback-worker.md) and paste its ID here.
  "kv_namespaces": [
    { "binding": "FEEDBACK", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" }
  ],
  // The live link to HermitShell (src/hub.js); SQLite-backed, so it is on the free plan.
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Hub"] }
  ]
  // Secrets, set with `npx wrangler secret put <NAME>` (never commit them):
  //   JOB_FEEDBACK_SECRET     signs the email links and HermitShell's API requests (same value as in HermitShell's .env)
  //   JOB_FEEDBACK_API_TOKEN  protects /events, /ack and /api/* (same value as in HermitShell's .env)
  //   ADMIN_PASSWORD          password for the /admin page (optional; /admin is off without it)
  //   ADMIN_USER              username for /admin (optional, defaults to "admin")
  //   ACCESS_AUD              Cloudflare Access application AUD tag; when set, /admin also needs Access
  //   ACCESS_TEAM_DOMAIN      your Access team domain, e.g. <team>.cloudflareaccess.com
}
